# ===== 必填 =====
# 火山引擎 Ark 平台 API Key，向项目队长索取
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# DeepSeek 官方平台 API Key
# 当前 configs/rag_config.yaml 里 llm.provider=deepseek，由 api_key_env 指向此变量
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== 嵌入模型（必填，勿留空）=====
# 本项目运行在离线/内网环境：实测 huggingface.co 直连 8s 超时不可达，
# 因此嵌入模型**必须**指向本地已下载好的完整模型目录。
# 该变量是嵌入模型路径的唯一真相源：scripts/build_index.py（建索引）与
# src/rag/embedding.py（运行时）共用同一份解析逻辑
# （src/rag/embedding.py::resolve_embedding_model_path）。
# 不再回退到 BAAI/bge-m3 之类的 Hub repo id——那会触发 2.2GB 联网下载。
#
# 相对路径以项目根目录为基准，也可写绝对路径。
#
# ⚠ 不要指向 models/bge-m3/：实测该目录是 BAAI/bge-m3 下载中断的残留
#   （只有 1_Pooling/ 与 imgs/，无任何权重文件），无法产出可用向量。
#   现在若指向这类残缺目录会直接报错并打印目录诊断，不会静默产出错误向量。
#
# 已验证 models/Xorbits/bge-m3 与官方 BAAI/bge-m3 是同一份权重
# （pytorch_model.bin md5 均为 767f43f2a03a47fce93b3ab353f209d0），
# 同文本编码后向量逐元素相同（余弦 1.0），可放心使用。
EMBEDDING_MODEL_PATH=models/Xorbits/bge-m3

# ===== 首次部署：先下载模型 =====
# 模型不入 git（.gitignore 忽略 models/），须在 clone 后手动下载一次：
#
#   ./.venv/Scripts/python.exe scripts/download_model.py          # ~2.2 GiB
#   ./.venv/Scripts/python.exe scripts/download_model.py --check  # 校验完整性
#
# 脚本默认走 hf-mirror（实测 huggingface.co 直连 502 不可达），
# 带 User-Agent（空 UA 会 403），失败重试 3 次，权重支持断点续传。
# 完整步骤见 DEPLOY.md 第 0 节。
